# Local development only. Change these credentials for any shared environment.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_local_only
POSTGRES_DB=hotel_dev
POSTGRES_PORT=5432

# If the database credentials or port above change, update this URL too.
DATABASE_URL=postgresql://hotel:hotel_local_only@localhost:5432/hotel_dev
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
RECEPTION_ORIGIN=http://localhost:5174
OWNER_ORIGIN=http://localhost:5175
# Optional exact public tunnel URL; trusted only in development, alongside local origins.
# DEV_TUNNEL_ORIGIN=https://your-domain.ngrok-free.dev
# npm run setup fills JWT_SECRET with a random 32-byte hex key in the ignored .env.
# Production: inject a separate secret, shared by every API instance. Never use VITE_.
JWT_SECRET=
JWT_ISSUER=pramod-api
JWT_AUDIENCE=pramod-web
JWT_TTL_SECONDS=900
# Server-only Deepgram key for reception speech to text. Never prefix it with VITE_.
DEEPGRAM_API_KEY=
# Public frontend links (optional locally; required for separate production hosts).
# VITE_GUEST_URL=https://www.example.com
# VITE_RECEPTION_URL=https://reception.example.com
# VITE_OWNER_URL=https://owner.example.com
# VITE_PROPERTY_SLUG=demo-hotel
NODE_ENV=development
