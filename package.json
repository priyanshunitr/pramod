{
  "name": "hotel-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate -w @hotel/api",
    "db:seed": "npm run db:seed -w @hotel/api",
    "owner:bootstrap": "npm run owner:bootstrap -w @hotel/api --",
    "test:integration": "npm run test:integration -w @hotel/api"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
