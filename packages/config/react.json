{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "noEmit": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
  }
}
