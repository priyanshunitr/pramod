{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.example"],
  "globalEnv": ["NODE_ENV", "API_PORT", "FRONTEND_ORIGIN", "RECEPTION_ORIGIN", "OWNER_ORIGIN", "DEV_TUNNEL_ORIGIN", "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS", "JWT_ISSUER", "JWT_AUDIENCE", "JWT_TTL_SECONDS", "VITE_*"],
  "globalPassThroughEnv": ["DATABASE_URL", "JWT_SECRET"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^typecheck"] },
    "dev": { "cache": false, "persistent": true }
  }
}
